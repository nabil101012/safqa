                </g>
                <!-- حرف a الأولى - لون أزرق -->
                <g class="path" style="opacity: 1; animation: 1s linear -0.471429s infinite normal forwards running animate-safqa;">
                    <path d="M15 0C23 0 28 6 28 15V35H21V29C19 33 15 36 10 36C3 36 -1 31 -1 24C-1 16 5 12 17 12H21V10C21 5 18 2 11 2C6 2 2 4 0 7L-5 3C2 -1 8 -3 15 -3M17 18H14C8 18 6 20 6 24C6 28 9 30 14 30C19 30 21 27 21 22V18Z" style="fill: rgb(22, 89, 139);" transform="translate(-40,-20)"></path>
                </g>
                <!-- حرف f الصحيح - لون أخضر -->
                <g class="path" style="opacity: 1; animation: 1s linear -0.377143s infinite normal forwards running animate-safqa;">
                    <path d="M16 -18C12 -18 9 -15 9 -10V-2H5V3H9V28C9 32 12 35 17 35H20V30H17C15 30 14 29 14 27V3H21V-2H14V-10C14 -12 15 -13 17 -13H20V-18Z" style="fill: rgb(16, 185, 129);" transform="translate(-10,-20)"></path>
                </g>
                <!-- حرف q - لون سماوي/تركواز -->
                <g class="path" style="opacity: 1; animation: 1s linear -0.282857s infinite normal forwards running animate-safqa;">
                    <path d="M15 0C23 0 29 6 29 17C29 28 23 35 15 35C7 35 1 28 1 17C1 6 7 0 15 0ZM15 5C10 5 7 10 7 17C7 24 10 30 15 30C20 30 23 24 23 17C23 10 20 5 15 5ZM27 33V50H21V33Z" style="fill: rgb(6, 182, 212);" transform="translate(20,-20)"></path>
