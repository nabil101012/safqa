                <g class="path" style="opacity: 1; animation: 1s linear -0.188571s infinite normal forwards running animate-safqa;">
                    <path d="M15 0C23 0 28 6 28 15V35H21V29C19 33 15 36 10 36C3 36 -1 31 -1 24C-1 16 5 12 17 12H21V10C21 5 18 2 11 2C6 2 2 4 0 7L-5 3C2 -1 8 -3 15 -3M17 18H14C8 18 6 20 6 24C6 28 9 30 14 30C19 30 21 27 21 22V18Z" style="fill: rgb(139, 92, 246);" transform="translate(60,-20)"></path>
                </g>
            </g>
            <text dy="0.35em" fill="#16598b" font-family="'Segoe UI', Tahoma, sans-serif" font-weight="bold" font-size="70" text-anchor="middle">Safqa</text>
        </g>
    </svg>
    <style type="text/css">
        @keyframes animate-safqa { 
            0% { transform: scale(0.91); opacity: 1; }
            50% { transform: scale(1.03); }
            100% { transform: scale(0.91); }
        }
        .bg-warning {
            background-color: #f97316 !important;
            color: #ffffff !important;
        }
        .btn-outline-warning {
            color: #f97316 !important;
            border-color: #f97316 !important;
            background-color: transparent !important;
        }
        .btn-outline-warning:hover {
            color: #ffffff !important;
            background-color: #f97316 !important;
            border-color: #f97316 !important;
        }
