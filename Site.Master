    <script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        const toggleBtn = document.getElementById("toggle-sidebar");
        const sidebar = document.querySelector(".sidebar-wrapper");

        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener("click", function () {
                sidebar.classList.toggle("mobile-show");
            });

            // Close sidebar when clicking outside on mobile
            document.addEventListener("click", function (event) {
                if (window.innerWidth <= 992) {
                    if (!sidebar.contains(event.target) && !toggleBtn.contains(event.target)) {
                        sidebar.classList.remove("mobile-show");
                    }
                }
            });
        }
    });
</script>

   
    <!-- نافذة الملف الشخصي (Profile Modal) -->
<!-- نافذة الملف الشخصي والإعدادات الموحدة (Unified Profile & Settings Modal) -->
<div class="modal fade" id="unifiedSettingsModal" tabindex="-1" aria-labelledby="unifiedSettingsModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="unifiedSettingsModalLabel">
                    <i class="bi bi-person-badge-fill me-2"></i> الملف الشخصي وإعدادات الحساب
                </h5>
                <button type="button" class="btn-close btn-close-white ms-0 me-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4 text-end">
                <!-- رأس النافذة: الصورة والاسم الأساسي -->
                <div class="text-center mb-4 pb-3 border-bottom">
                    <img src="../assets/images/userx.png" class="rounded-circle shadow-sm mb-2 border border-3 border-primary p-1" width="90" height="90" alt="Profile">
                    <h4 class="fw-bold text-dark mb-1" runat="server" id="modalHeaderUserName">اسم المستخدم</h4>
                    <span class="badge bg-light text-primary border px-3 py-1 rounded-pill">حساب مستخدم نشط</span>
                </div>

                <!-- التبويبات الداخلية (البيانات الشخصية | تغيير كلمة المرور | الصلاحيات) -->
                <ul class="nav nav-pills mb-3 justify-content-center" id="unifiedTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold px-3" id="info-tab" data-bs-toggle="pill" data-bs-target="#infoContent" type="button" role="tab">بيانات الحساب</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold px-3" id="password-tab" data-bs-toggle="pill" data-bs-target="#passwordContent" type="button" role="tab">تغيير كلمة المرور</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold px-3" id="permissions-tab" data-bs-toggle="pill" data-bs-target="#permissionsContent" type="button" role="tab">الصلاحيات الممنوحة</button>
                    </li>
                </ul>
                <hr>

                <div class="tab-content" id="unifiedTabContent">
                    
                    <!-- 1. تبويب بيانات الحساب (الاسم، الشركة، تاريخ الانضمام) -->
                    <div class="tab-pane fade show active" id="infoContent" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">اسم المستخدم:</label>
                                <asp:TextBox ID="txtProfileUserName" runat="server" CssClass="form-control bg-light text-end" ReadOnly="true"></asp:TextBox>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">الشركة التابع لها:</label>
                                <asp:TextBox ID="txtProfileCompanyName" runat="server" CssClass="form-control bg-light text-end" ReadOnly="true" Text="غير مسجل"></asp:TextBox>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">تاريخ الانضمام / التسجيل:</label>
                                <asp:TextBox ID="txtProfileJoinDate" runat="server" CssClass="form-control bg-light text-end" ReadOnly="true" Text="--/--/----"></asp:TextBox>
                            </div>
                        </div>
                    </div>

                    <!-- 2. تبويب تغيير كلمة المرور -->
                    <div class="tab-pane fade" id="passwordContent" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label class="form-label text-muted small fw-semibold">كلمة المرور الحالية:</label>
                                <asp:TextBox ID="txtCurrentPass" runat="server" CssClass="form-control bg-light" TextMode="Password" autocomplete="new-password"></asp:TextBox>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">كلمة المرور الجديدة:</label>
                                <asp:TextBox ID="txtNewPass" runat="server" CssClass="form-control bg-light" TextMode="Password" autocomplete="new-password"></asp:TextBox>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-semibold">تأكيد كلمة المرور:</label>
                                <asp:TextBox ID="txtConfirmPass" runat="server" CssClass="form-control bg-light" TextMode="Password" autocomplete="new-password"></asp:TextBox>
                            </div>
                            <div class="col-md-12 text-center mt-3">
                                <asp:Label ID="lblPassMessage" runat="server" CssClass="small fw-bold d-block mb-2"></asp:Label>
                                <asp:Button ID="btnChangePassword" runat="server" Text="حفظ كلمة المرور الجديدة" CssClass="btn btn-primary btn-sm px-4 fw-bold rounded-3" OnClick="btnChangePassword_Click" />
                            </div>
                        </div>
                    </div>

                    <!-- 3. تبويب الصلاحيات -->
                    <div class="tab-pane fade" id="permissionsContent" role="tabpanel">
                        <h6 class="fw-bold text-secondary mb-3">قائمة الصلاحيات المخصصة لحسابك:</h6>
                        <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                            <asp:GridView ID="gvUserPermissions" runat="server" CssClass="table table-bordered table-sm text-center" AutoGenerateColumns="true" EmptyDataText="لا توجد صلاحيات مسجلة أو مخصصة." Width="100%">
                            </asp:GridView>
                        </div>
                    </div>

                </div>

            </div>
            
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary btn-sm px-4 rounded-3" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<!-- نافذة الإعدادات وتغيير كلمة المرور والصلاحيات (Settings Modal) -->

<script type="text/javascript">
    document.addEventListener("DOMContentLoaded", function () {
        // Find all textboxes or search inputs across the page
        var searchInputs = document.querySelectorAll('input[type="text"], input[type="search"], .search__input');

        searchInputs.forEach(function (input) {
            // Force disable autocomplete via JS attribute injection
            input.setAttribute('autocomplete', 'off');
            input.setAttribute('readonly', 'true'); // Temporarily removes focus read state

            // Allow typing by removing readonly on focus
            input.addEventListener('focus', function () {
                this.removeAttribute('readonly');
            });
        });
    });
</script>
 </form>
</body>
</html>
